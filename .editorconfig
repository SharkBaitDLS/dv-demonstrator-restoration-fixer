root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

indent_style = space
indent_size = 4

# Remove trailing whitespace in all files except markdown files
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.cs]
# ?., ?? and ??= bypass Unity's null check, so a destroyed object reads as alive.
dotnet_diagnostic.UNT0007.severity = warning
dotnet_diagnostic.UNT0008.severity = warning
dotnet_diagnostic.UNT0023.severity = warning
